{
  "name": "vscode-player",
  "displayName": "Player",
  "description": "Watch videos in a panel right next to your terminal.",
  "version": "0.0.1",
  "publisher": "hootbu",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "player.togglePlay",
        "title": "Play / Pause",
        "category": "Player"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "playerPanel",
          "title": "Player",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "playerPanel": [
        {
          "id": "playerPanel.view",
          "name": "Player",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Player",
      "properties": {
        "player.region": {
          "type": "string",
          "default": "TR",
          "description": "Search region code (gl), e.g. TR, US, DE."
        },
        "player.language": {
          "type": "string",
          "default": "tr",
          "description": "Search language code (hl), e.g. tr, en, de."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "opus-decoder": "^0.7.11",
    "youtubei.js": "^18.0.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
